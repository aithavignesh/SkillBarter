# SkillBarter Environment Variables Example

# ==========================================
# Backend Configuration
# ==========================================
# Use SQLite for instant zero-dependency local dev/tests:
DATABASE_URL=sqlite:///./skillbarter.db
# Or PostgreSQL + PostGIS for production/docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/skillbarter

SECRET_KEY=skillbarter-super-secret-production-key-2026-hyperlocal
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_URL=http://localhost:8000/api
