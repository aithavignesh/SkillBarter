{
  "name": "skillbarter-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "next-app",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w next-app\" \"npm run dev -w server\"",
    "dev:web": "npm run dev -w next-app",
    "dev:api": "npm run dev -w server",
    "build": "npm run build -w next-app",
    "start:web": "npm run start -w next-app",
    "start:api": "npm run start -w server",
    "lint": "npm run lint -w next-app",
    "check": "npm run verify:stack && npm run check -w server && npm run lint -w next-app && npm run build && npm run test:staging",
    "test": "npm run test -w server",
    "verify:stack": "node scripts/verify-mern-stack.mjs",
    "preflight:migration": "node server/src/migrations/validateMigrationPreflight.js",
    "test:staging": "node --test scripts/test/verify-staging.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
