# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/skillbarter

# Must be at least 32 characters. Generate a unique random value for each environment.
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional separate HMAC secret for email OTP hashes; if omitted, JWT_SECRET is used.
OTP_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:3000

# Configure these in the deployment environment to enable password recovery.
# Use credentials from your SMTP provider; do not commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Full HTTPS URL of the frontend password-reset page in production.
PASSWORD_RESET_URL=

# Optional SMS OTP provider (Twilio Verify). Set all three values to enable phone OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
