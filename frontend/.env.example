# Client-side InsForge configuration
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=

# Server-side phone OTP configuration (Vercel Production only)
# India-first provider. Never expose these in VITE_* variables.
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=LOGIN_OTP

# Existing OTP/session security
PHONE_AUTH_SECRET=

# Optional first-party funnel analytics collector
# Keep this unset until a privacy-reviewed collector is deployed.
VITE_ANALYTICS_ENDPOINT=

# Optional Twilio fallback (only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Razorpay Premium Membership payments (server-side only; never use the secret in VITE_* vars)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# InsForge server-side access for payment routes
INSFORGE_URL=
INSFORGE_ANON_KEY=
