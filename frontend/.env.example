# Client-side InsForge configuration
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=

# Server-side phone OTP configuration (Vercel Production only)
# India-first provider. Never expose these in VITE_* variables.
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=LOGIN_OTP

# Existing OTP/session security
PHONE_AUTH_SECRET=

# Optional Twilio fallback (only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
