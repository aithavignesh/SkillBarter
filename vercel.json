{
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "cd frontend && npm install --no-audit --no-fund",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
